@model List<BeeciyeMarket.Models.Product>
@{
    ViewData["Title"] = "My Products";
    Layout = "_DashboardLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>My Products</h1>
    <a asp-controller="Product" asp-action="Create" class="btn btn-beeciye-gold">Add Product</a>
</div>

@if (!Model.Any())
{
    <p class="text-muted">You haven't listed any products yet.</p>
}
else
{
    <table class="table align-middle">
        <thead>
            <tr>
                <th></th>
                <th>Name</th>
                <th>Category</th>
                <th>Price</th>
                <th>Qty</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in Model)
            {
                <tr>
                    <td><img src="@(string.IsNullOrEmpty(product.ImagePath) ? "/images/products/no-image.svg" : product.ImagePath)" style="width:60px;height:60px;object-fit:cover;" class="rounded" /></td>
                    <td>@product.Name</td>
                    <td>@product.Category?.Name</td>
                    <td>$@product.CurrentValue.ToString("0.00")</td>
                    <td>@product.Quantity</td>
                    <td>
                        @if (product.Quantity < 1)
                        {
                            <span class="badge badge-status-completed">Sold</span>
                        }
                        else
                        {
                            <span class="badge @(product.IsActive ? "badge-status-active" : "badge-status-inactive")">@(product.IsActive ? "Active" : "Inactive")</span>
                        }
                    </td>
                    <td class="text-end">
                        <a asp-controller="Product" asp-action="Edit" asp-route-id="@product.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-controller="Product" asp-action="Delete" asp-route-id="@product.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this product?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
