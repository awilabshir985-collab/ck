@model BeeciyeMarket.Models.ViewModels.SellerDashboardViewModel
@{
    ViewData["Title"] = "Seller Dashboard";
    Layout = "_DashboardLayout";
}

<h1 class="mb-4">Seller Dashboard</h1>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card beeciye-stat-card">
            <div class="card-body d-flex align-items-center gap-3">
                <span class="beeciye-stat-icon"><i class="bi bi-box-seam"></i></span>
                <div>
                    <h3 class="mb-0">@Model.TotalProducts</h3>
                    <small class="text-muted">Total Products</small>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card beeciye-stat-card">
            <div class="card-body d-flex align-items-center gap-3">
                <span class="beeciye-stat-icon"><i class="bi bi-receipt"></i></span>
                <div>
                    <h3 class="mb-0">@Model.TotalOrders</h3>
                    <small class="text-muted">Total Orders</small>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card beeciye-stat-card">
            <div class="card-body d-flex align-items-center gap-3">
                <span class="beeciye-stat-icon"><i class="bi bi-cash-stack"></i></span>
                <div>
                    <h3 class="mb-0">$@Model.TotalSales.ToString("0.00")</h3>
                    <small class="text-muted">Total Sales</small>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0">Recent Products</h5>
    <a asp-controller="Product" asp-action="MyProducts" class="small">View All</a>
</div>
<div class="card">
    <table class="table align-middle mb-0">
        <thead>
            <tr>
                <th></th>
                <th>Name</th>
                <th>Price</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model.RecentProducts)
            {
                <tr>
                    <td><img src="@(string.IsNullOrEmpty(p.ImagePath) ? "/images/products/no-image.svg" : p.ImagePath)" style="width:44px;height:44px;object-fit:cover;" class="rounded" /></td>
                    <td>@p.Name</td>
                    <td>$@p.CurrentValue.ToString("0.00")</td>
                    <td><span class="badge @(p.IsActive ? "badge-status-active" : "badge-status-inactive")">@(p.IsActive ? "Active" : "Inactive")</span></td>
                </tr>
            }
        </tbody>
    </table>
</div>
