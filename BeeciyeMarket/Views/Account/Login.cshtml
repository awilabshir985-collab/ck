@model BeeciyeMarket.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Log in";
    Layout = "_AuthLayout";
}

<ul class="nav nav-pills mb-4">
    <li class="nav-item">
        <span class="nav-link active">Log in</span>
    </li>
    <li class="nav-item">
        <a class="nav-link" asp-controller="Account" asp-action="Register" asp-route-returnUrl="@ViewData["ReturnUrl"]">Register</a>
    </li>
</ul>

<h2 class="mb-1">Welcome back</h2>
<p class="text-muted mb-4">Log in to your Beeciye account.</p>

<form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" autofocus />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Password" class="form-label"></label>
        <input asp-for="Password" class="form-control" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>

    <div class="mb-3 form-check">
        <input asp-for="RememberMe" class="form-check-input" />
        <label asp-for="RememberMe" class="form-check-label"></label>
    </div>

    <button type="submit" class="btn btn-beeciye-gold w-100">Log in</button>
</form>

<hr class="my-4" />
<p class="text-center mb-0">
    <a asp-controller="Product" asp-action="Create">Sell an item without an account</a>
</p>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
