<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Beeciye</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BeeciyeMarket.styles.css" asp-append-version="true" />
</head>
<body class="beeciye-auth-body">
    <div class="beeciye-auth-shell">
        <div class="beeciye-auth-form-pane">
            <a class="beeciye-brand beeciye-auth-brand" asp-controller="Home" asp-action="Index">
                <span class="beeciye-logo-icon"><i class="bi bi-shop"></i></span>
                <span class="text-dark">Beeciye<small class="text-muted">Second-Hand Market</small></span>
            </a>

            <div class="beeciye-auth-content">
                @RenderBody()
            </div>
        </div>

        <div class="beeciye-auth-art-pane d-none d-lg-flex">
            <svg viewBox="0 0 480 480" class="beeciye-auth-illustration" role="img" aria-label="Second-hand marketplace illustration">
                <circle cx="240" cy="240" r="200" fill="rgba(245,179,1,0.08)" />
                <circle cx="240" cy="240" r="150" fill="rgba(245,179,1,0.10)" />

                <rect x="150" y="190" width="180" height="150" rx="14" fill="#f5b301" />
                <path d="M185 190 v-24 a35 35 0 0 1 70 0 v24" fill="none" stroke="#10193a" stroke-width="10" stroke-linecap="round" />
                <circle cx="200" cy="230" r="8" fill="#10193a" />
                <circle cx="280" cy="230" r="8" fill="#10193a" />

                <rect x="70" y="90" width="70" height="110" rx="10" fill="#ffffff" stroke="#10193a" stroke-width="4" />
                <rect x="85" y="105" width="40" height="60" rx="4" fill="#10193a" opacity="0.85" />
                <circle cx="105" cy="180" r="6" fill="#10193a" opacity="0.6" />

                <rect x="330" y="120" width="90" height="64" rx="6" fill="#ffffff" stroke="#10193a" stroke-width="4" />
                <rect x="330" y="184" width="90" height="8" rx="3" fill="#10193a" opacity="0.7" />
                <rect x="360" y="192" width="30" height="8" rx="3" fill="#10193a" opacity="0.5" />

                <path d="M110 330 q30 -40 60 0 t60 0 t60 0" fill="none" stroke="#ffffff" stroke-width="8" stroke-linecap="round" opacity="0.9" />

                <circle cx="360" cy="300" r="22" fill="#198754" />
                <path d="M350 300 l7 7 14 -14" fill="none" stroke="#fff" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <h3 class="text-white mt-4">Buy &amp; Sell Second-Hand</h3>
            <p class="text-white-50 text-center px-5">Quality products, trusted sellers, and fair prices — all in one marketplace.</p>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
