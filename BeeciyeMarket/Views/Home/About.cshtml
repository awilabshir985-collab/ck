@{
    ViewData["Title"] = "About Us";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <h1 class="mb-4">About Beeciye</h1>
        <p class="fs-5">
            Beeciye is a second-hand marketplace that connects buyers and sellers in your community.
            We make it easy to give quality used goods a second life &mdash; from electronics and
            furniture to clothing and vehicles &mdash; at fair prices.
        </p>
        <div class="row g-4 mt-3">
            <div class="col-md-4 text-center">
                <span class="beeciye-icon-circle mb-2"><i class="bi bi-shield-check"></i></span>
                <h6 class="mt-2">Trusted Sellers</h6>
                <p class="text-muted small">Every seller is a registered, verified member of our community.</p>
            </div>
            <div class="col-md-4 text-center">
                <span class="beeciye-icon-circle mb-2"><i class="bi bi-tags"></i></span>
                <h6 class="mt-2">Best Prices</h6>
                <p class="text-muted small">Quality second-hand goods at a fraction of the original price.</p>
            </div>
            <div class="col-md-4 text-center">
                <span class="beeciye-icon-circle mb-2"><i class="bi bi-cart-check"></i></span>
                <h6 class="mt-2">Easy Buying</h6>
                <p class="text-muted small">Browse, add to cart, and check out in just a few clicks.</p>
            </div>
        </div>
    </div>
</div>
