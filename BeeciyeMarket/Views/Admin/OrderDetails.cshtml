@model BeeciyeMarket.Models.Order
@{
    ViewData["Title"] = "Order #" + Model.Id;
    Layout = "_DashboardLayout";
    ViewBag.ActiveNav = "Orders";
}

<h1 class="mb-4">Order #@Model.Id</h1>

<div class="row g-4">
    <div class="col-md-7">
        <div class="card mb-4">
            <div class="card-body">
                <h6 class="card-title">Items</h6>
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Seller</th>
                            <th>Qty</th>
                            <th>Unit Price</th>
                            <th>Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.OrderItems)
                        {
                            <tr>
                                <td>@item.Product?.Name</td>
                                <td>@item.Seller?.FullName</td>
                                <td>@item.Quantity</td>
                                <td>$@item.UnitPrice.ToString("0.00")</td>
                                <td>$@item.TotalPrice.ToString("0.00")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-md-5">
        <div class="card mb-4">
            <div class="card-body">
                <h6 class="card-title">Order Info</h6>
                <p class="mb-1"><strong>Customer:</strong> @(Model.Customer?.FullName ?? Model.ShippingFullName) @(Model.Customer == null ? "(Guest)" : "")</p>
                <p class="mb-1"><strong>Date:</strong> @Model.OrderDate.ToString("MMM d, yyyy")</p>
                <p class="mb-1"><strong>Status:</strong> <span class="badge badge-status-@Model.Status.ToString().ToLower()">@Model.Status</span></p>
                <p class="mb-1"><strong>Total:</strong> $@Model.TotalPrice.ToString("0.00")</p>
                <hr />
                <p class="mb-1"><strong>Name:</strong> @Model.ShippingFullName</p>
                <p class="mb-1"><strong>Phone:</strong> @Model.ShippingPhone</p>
                <p class="mb-1"><strong>Address:</strong> @Model.ShippingAddress</p>
                <p class="mb-1"><strong>Payment Method:</strong> @Model.PaymentMethod.ToDisplayName()</p>

                <p class="mb-1 mt-2"><strong>Payments</strong></p>
                @if (!Model.Payments.Any())
                {
                    <p class="text-muted">No payment record yet.</p>
                }
                else
                {
                    <ul class="list-group mb-2">
                        @foreach (var payment in Model.Payments.OrderByDescending(p => p.PaymentDate))
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span>$@payment.Amount.ToString("0.00") &middot; @payment.PaymentMethod.ToDisplayName() &middot; @payment.PaymentDate.ToString("MMM d, yyyy")</span>
                                <span class="badge badge-status-@payment.Status.ToString().ToLower()">@payment.Status</span>
                            </li>
                        }
                    </ul>
                    var totalPaid = Model.Payments.Where(p => p.Status == BeeciyeMarket.Models.PaymentStatus.Paid).Sum(p => p.Amount);
                    <p class="small text-muted">$@totalPaid.ToString("0.00") of $@Model.TotalPrice.ToString("0.00") paid</p>
                }
                <a asp-controller="Admin" asp-action="CreatePayment" class="btn btn-sm btn-outline-secondary">+ Add Payment</a>

                <form asp-controller="Admin" asp-action="UpdateOrderStatus" asp-route-id="@Model.Id" method="post" class="d-flex gap-2 mt-3">
                    <select name="status" class="form-select form-select-sm">
                        @foreach (var status in Enum.GetValues<BeeciyeMarket.Models.OrderStatus>())
                        {
                            <option value="@status" selected="@(status == Model.Status)">@status</option>
                        }
                    </select>
                    <button type="submit" class="btn btn-sm btn-beeciye-gold">Update Status</button>
                </form>
            </div>
        </div>
        <a asp-controller="Admin" asp-action="Orders" class="btn btn-link ps-0">Back to Orders</a>
    </div>
</div>
