@model List<BeeciyeMarket.Models.Product>
@{
    ViewData["Title"] = "Manage Products";
    Layout = "_DashboardLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Manage Products</h1>
    <a asp-controller="Admin" asp-action="CreateProduct" class="btn btn-beeciye-gold"><i class="bi bi-plus-circle"></i> Add Product</a>
</div>

<div class="card">
    <table class="table align-middle mb-0">
        <thead>
            <tr>
                <th></th>
                <th>Name</th>
                <th>Seller</th>
                <th>Category</th>
                <th>Price</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in Model)
            {
                <tr>
                    <td><img src="@(string.IsNullOrEmpty(product.ImagePath) ? "/images/products/no-image.svg" : product.ImagePath)" style="width:44px;height:44px;object-fit:cover;" class="rounded" /></td>
                    <td>@product.Name</td>
                    <td>@(product.Seller?.FullName ?? product.GuestName) @(product.Seller == null ? "(Guest)" : "")</td>
                    <td>@product.Category?.Name</td>
                    <td>$@product.CurrentValue.ToString("0.00")</td>
                    <td>
                        @if (product.Quantity < 1)
                        {
                            <span class="badge badge-status-completed">Sold</span>
                        }
                        else
                        {
                            <span class="badge @(product.IsActive ? "badge-status-active" : "badge-status-inactive")">@(product.IsActive ? "Active" : "Inactive")</span>
                        }
                    </td>
                    <td class="d-flex gap-1">
                        <a asp-controller="Admin" asp-action="EditProduct" asp-route-id="@product.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-controller="Admin" asp-action="ToggleProductActive" asp-route-id="@product.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-secondary">@(product.IsActive ? "Deactivate" : "Activate")</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
