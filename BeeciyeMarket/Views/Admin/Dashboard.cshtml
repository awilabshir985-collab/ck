@model BeeciyeMarket.Models.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "_DashboardLayout";
}

<h1 class="mb-4">Admin Dashboard</h1>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <a asp-controller="Admin" asp-action="Users" class="text-decoration-none">
            <div class="card beeciye-stat-card"><div class="card-body d-flex align-items-center gap-3"><span class="beeciye-stat-icon"><i class="bi bi-people"></i></span><div><h3 class="mb-0 text-dark">@Model.TotalUsers</h3><small class="text-muted">Users</small></div></div></div>
        </a>
    </div>
    <div class="col-md-3">
        <a asp-controller="Admin" asp-action="Products" class="text-decoration-none">
            <div class="card beeciye-stat-card"><div class="card-body d-flex align-items-center gap-3"><span class="beeciye-stat-icon"><i class="bi bi-shop"></i></span><div><h3 class="mb-0 text-dark">@Model.TotalSellers</h3><small class="text-muted">Sellers</small></div></div></div>
        </a>
    </div>
    <div class="col-md-3">
        <a asp-controller="Admin" asp-action="Products" class="text-decoration-none">
            <div class="card beeciye-stat-card"><div class="card-body d-flex align-items-center gap-3"><span class="beeciye-stat-icon"><i class="bi bi-box-seam"></i></span><div><h3 class="mb-0 text-dark">@Model.TotalProducts</h3><small class="text-muted">Products</small></div></div></div>
        </a>
    </div>
    <div class="col-md-3">
        <a asp-controller="Admin" asp-action="Orders" class="text-decoration-none">
            <div class="card beeciye-stat-card"><div class="card-body d-flex align-items-center gap-3"><span class="beeciye-stat-icon"><i class="bi bi-cash-stack"></i></span><div><h3 class="mb-0 text-dark">$@Model.TotalSales.ToString("0.00")</h3><small class="text-muted">@Model.TotalOrders orders</small></div></div></div>
        </a>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <h5>Recent Products</h5>
        <ul class="list-group mb-4">
            @foreach (var p in Model.RecentProducts)
            {
                <a asp-controller="Admin" asp-action="EditProduct" asp-route-id="@p.Id" class="list-group-item list-group-item-action d-flex justify-content-between">
                    <span>@p.Name (@p.Seller?.FullName)</span>
                    <span>$@p.CurrentValue.ToString("0.00")</span>
                </a>
            }
            @if (!Model.RecentProducts.Any())
            {
                <li class="list-group-item text-muted">No products yet.</li>
            }
        </ul>
    </div>
    <div class="col-md-6">
        <h5>Recent Orders</h5>
        <ul class="list-group mb-4">
            @foreach (var o in Model.RecentOrders)
            {
                <a asp-controller="Admin" asp-action="OrderDetails" asp-route-id="@o.Id" class="list-group-item list-group-item-action d-flex justify-content-between">
                    <span>#@o.Id - @(o.Customer?.FullName ?? o.ShippingFullName)</span>
                    <span>$@o.TotalPrice.ToString("0.00")</span>
                </a>
            }
            @if (!Model.RecentOrders.Any())
            {
                <li class="list-group-item text-muted">No orders yet.</li>
            }
        </ul>
    </div>
</div>

