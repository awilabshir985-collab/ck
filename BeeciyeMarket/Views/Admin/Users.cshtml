@model List<BeeciyeMarket.Models.ApplicationUser>
@{
    ViewData["Title"] = "Manage Users";
    Layout = "_DashboardLayout";
    var userRoles = (Dictionary<string, List<string>>)ViewBag.UserRoles;
    string? roleFilter = ViewBag.RoleFilter;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Manage Users</h1>
    <a asp-controller="Admin" asp-action="CreateUser" class="btn btn-beeciye-gold"><i class="bi bi-plus-circle"></i> Add User</a>
</div>

<ul class="nav nav-tabs mb-3">
    <li class="nav-item"><a class="nav-link @(roleFilter == null ? "active" : "")" asp-controller="Admin" asp-action="Users">All</a></li>
    <li class="nav-item"><a class="nav-link @(roleFilter == "User" ? "active" : "")" asp-controller="Admin" asp-action="Users" asp-route-role="User">Users</a></li>
    <li class="nav-item"><a class="nav-link @(roleFilter == "Admin" ? "active" : "")" asp-controller="Admin" asp-action="Users" asp-route-role="Admin">Admins</a></li>
</ul>

<div class="card">
    <table class="table align-middle mb-0">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>City</th>
                <th>Roles</th>
                <th>Joined</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.FullName</td>
                    <td>@user.Email</td>
                    <td>@user.City</td>
                    <td>
                        @foreach (var role in userRoles.GetValueOrDefault(user.Id, new List<string>()))
                        {
                            <span class="badge bg-secondary me-1">@role</span>
                        }
                    </td>
                    <td>@user.CreatedAt.ToString("MMM d, yyyy")</td>
                    <td><a asp-controller="Admin" asp-action="EditUser" asp-route-id="@user.Id" class="btn btn-sm btn-outline-secondary">Edit</a></td>
                </tr>
            }
        </tbody>
    </table>
</div>
